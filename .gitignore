# Machine-specific files (each contributor keeps their own)
CLAUDE.md
build_and_deploy.bat
.claude/

# Build output (CMake generated)
/build/

# Release packages
/Releases/

# RE artifacts (NOT in this repo — see ../FFXII-Decompile/)
